@@ -0,0 +1,39 @@
+package com.example.data
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+/** Locks the approved DepEd rules (Nov 10, 2026). Pure JVM: no Firebase or Android needed. */
+class DepEdCalculatorRulesTest {
+
+  @Test
+  fun proficiencyUsesSevenBands() {
+    assertEquals("Mastered", DepEdCalculator.proficiencyFromPct(96.0))
+    assertEquals("Closely Approximating Mastery", DepEdCalculator.proficiencyFromPct(86.0))
+    assertEquals("Moving Towards Mastery", DepEdCalculator.proficiencyFromPct(66.0))
+    assertEquals("Average Mastery", DepEdCalculator.proficiencyFromPct(35.0))
+    assertEquals("Low Mastery", DepEdCalculator.proficiencyFromPct(20.0))
+    assertEquals("Very Low Mastery", DepEdCalculator.proficiencyFromPct(5.0))
+    assertEquals("Absolutely No Mastery", DepEdCalculator.proficiencyFromPct(4.99))
+  }
+
+  @Test
+  fun itemRemarkUsesErrorRate() {
+    assertEquals("Critical Competency for Review", DepEdCalculator.itemRemark(50.01))
+    assertEquals("Least Mastered", DepEdCalculator.itemRemark(50.0))
+    assertEquals("Least Mastered", DepEdCalculator.itemRemark(25.01))
+    assertEquals("Mastered", DepEdCalculator.itemRemark(25.0))
+  }
+
+  @Test
+  fun summativeMapehDefaultSplitIsTwelveThenThirteen() {
+    val config = ExamConfig()
+    assertEquals(12, config.mapehComp1Items)
+    assertEquals(13, config.mapehComp2Items)
+  }
+
+  @Test
+  fun passingMarkIsSixtyPercent() {
+    assertEquals(0.60, DepEdCalculator.PASSING_FRACTION, 0.0001)
+  }
+}
